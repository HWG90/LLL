+-- deps: {memory (bingus_memory's api), native (Engine.open's), game (game.dll base as a number), Weapons, Engine, read
+-- (Avatar.reader), lookup (Avatar.lookup); tests: write(address, expected 4 bytes, replacement 4 bytes) -> true or nil
+-- and why, call(address, manager, owner_at) (the allocator)}.
+-- Returns {prepare(resolved) -> made, problems; sync(bindings, resolved) -> held, problems; release() -> done,
+-- problems; held(); counters leased, released, made, calls, refused; broken (why the source is off for the session)}.
+function WeaponSource.new(deps)
+    local memory, native, game = deps.memory, deps.native, deps.game
+    local Weapons, Engine, read, lookup = deps.Weapons, deps.Engine, deps.read, deps.lookup
+    local POINTER, WRITABLE = ffi.typeof('const uint8_t *'), ffi.typeof('uint8_t *')
+    local CLONE = ffi.typeof('void (*)(void *, const void *, const void *)')
+    local self = {leased = 0, released = 0, made = 0, calls = 0, refused = 0, broken = nil}
+    local records = {} -- [weapon entity id .. ':' .. row] = {id, row, bytes (the 40 as journaled), masked, place}
+
+    -- The bytes at an address (a number) as a string, or nil when they cannot all be read.
+    local function bytes(address, size)
+        if type(address) ~= 'number' or address < 0x10000 or address + size > 0x800000000000 then return nil end
+        return memory.read(ffi.cast(POINTER, address), size)
+    end
+    local function pointer_at(address)
+        local s = bytes(address, 8)
+        if not s then return nil end
+        local value = u64(s, 0)
+        if value < 0x10000 or value >= 0x800000000000 then return nil end
+        return value
+    end
+    -- One 4-byte write (expected -> replacement) into committed private read-write memory, read back; true, or nil
+    -- and why.
+    local write = deps.write or function(address, expected, replacement)
+        local p = ffi.cast(WRITABLE, address)
+        if not memory.writable_data(p, 4) then return nil, 'the selector is not private writable data' end
+        if memory.read(p, 4) ~= expected then return nil, 'the selector changed before the write' end
+        ffi.copy(p, replacement, 4)
+        if memory.read(p, 4) ~= replacement then return nil, 'the selector did not take the write' end
+        return true
+    end
+    -- The game's allocator: a private copy of the weapon's (owner_at's) type component, from an empty descriptor.
+    local call = deps.call or function(address, manager, owner_at)
+        local empty = ffi.new('uint32_t[3]')
+        ffi.cast(CLONE, address)(ffi.cast('void *', manager), ffi.cast('const void *', owner_at), empty)
+    end
+
+    -- A game map's table ({u64 data, u32 capacity, u32 empty, u32 multiplier}; entries {u32 key, u32 value}), read
+    -- whole: data (string), capacity, empty; or nil.
+    local function map_table(address)
+        local h = bytes(address, 20)
+        if not h then return nil end
+        local data, capacity, empty = u64(h, 0), u32(h, 8), u32(h, 12)
+        if capacity == 0 or capacity > MAX_MAP or data < 0x10000 then return nil end
+        local table_bytes = bytes(data, capacity * 8)
+        if not table_bytes then return nil end
+        return table_bytes, capacity, empty
+    end
+    -- Whether `value` is held by `key` alone in the map at address (no other weapon aliases that copy).
+    local function sole(address, key, value)
+        local t, capacity, empty = map_table(address)
+        if not t then return false end
+        local holders = 0
+        for i = 0, capacity - 1 do
+            local k = u32(t, i * 8)
+            if k ~= empty and u32(t, i * 8 + 4) == value then
+                if k ~= key then return false end
+                holders = holders + 1
+            end
+        end
+        return holders == 1
+    end
+
+    -- A weapon's place in the manager: {manager, instance, owner_at, owner (its 24 bytes), index and copy (the
+    -- address of its private copy; nil without one)}, or nil and why.
+    local function locate(id)
+        local manager = pointer_at(game + Weapons.CUSTOMIZATION)
+        if not manager then return nil, 'the weapon customization manager is unreadable' end
+        local instance = lookup(read, manager + M_INSTANCES, id)
+        if not instance or instance >= MAX_MAP then return nil, 'the weapon has no instance' end
+        local owners = pointer_at(manager + M_OWNERS)
+        local owner_at = owners and pointer_at(owners + 8 * instance)
+        local owner = owner_at and bytes(owner_at, 24)
+        if not owner or u32(owner, 8) ~= id then return nil, 'the weapon\'s owner record is another entity\'s' end
+        local place = {id = id, manager = manager, instance = instance, owner_at = owner_at, owner = owner}
+        local index = lookup(read, manager + M_COPY_MAP, id)
+        if index then
+            if index >= MAX_MAP then return nil, 'the private copy index is out of bounds' end
+            local copies = pointer_at(manager + M_COPIES)
+            if not copies then return nil, 'the private copies are unreadable' end
+            place.index, place.copy = index, copies + COPY_BYTES * index
+        end
+        return place
+    end
+    -- The same weapon still where `place` found it (manager, instance, owner): its place now (the copy may have
+    -- moved), or nil.
+    local function same(place)
+        local now = locate(place.id)
+        if not now or now.manager ~= place.manager or now.instance ~= place.instance or now.owner_at ~= place.owner_at
+            or now.owner ~= place.owner then
+            return nil
+        end
+        return now
+    end
+
+    -- The type component of the weapon whose id is the 8 bytes `id8`: its address, or nil and why.
+    local function component(id8)
+        local entities = pointer_at(game + Weapons.ENTITIES)
+        local types = entities and pointer_at(entities + TYPES)
+        local buckets = types and bytes(types, TYPE_BUCKETS * 16)
+        if not buckets then return nil, 'the weapon types are unreadable' end
+        local index
+        for i = 0, TYPE_BUCKETS - 1 do
+            if buckets:sub(i * 16 + 1, i * 16 + 8) == id8 then
+                if index then return nil, 'the weapon type is listed twice' end
+                index = u32(buckets, i * 16 + 8)
+            end
+        end
+        if not index or index >= TYPE_BUCKETS then return nil, 'the weapon type is not listed' end
+        return types + TYPE_BASE + COPY_BYTES * index
+    end
+
+    -- A private copy for the weapon at `place` (which has none), from the game's allocator; true when made, or nil
+    -- and why. A copy that differs from its type afterwards disables the source for the session (self.broken).
+    local function ensure(place)
+        for _, s in ipairs(WeaponSource.SIGNATURES) do
+            local expected = from_hex(s[2])
+            local now = bytes(game + s[1], #expected)
+            if now == nil then return nil, 'the allocator\'s code is not readable yet' end
+            if now ~= expected then return nil, 'the allocator changed (another game build)' end
+        end
+        local count_s, capacity_s = bytes(place.manager + M_COUNT, 4), bytes(place.manager + M_CAPACITY, 4)
+        if not count_s or not capacity_s then return nil, 'the private copies\' count is unreadable' end
+        local count, capacity = u32(count_s, 0), u32(capacity_s, 0)
+        if not (count < capacity and capacity <= MAX_MAP) then return nil, 'the private copies are full' end
+        local copies = pointer_at(place.manager + M_COPIES)
+        if not copies then return nil, 'the private copies are unreadable' end
+        local original, why = component(place.owner:sub(1, 8))
+        if not original then return nil, why end
+        local baseline = bytes(original, COPY_BYTES)
+        if not baseline then return nil, 'the weapon type is unreadable' end
+        local before = same(place)
+        if not before then return nil, 'the weapon changed before its copy was made' end
+        if before.copy then return true end -- the game made one meanwhile
+        self.calls = self.calls + 1
+        call(game + WeaponSource.ALLOCATOR, place.manager, place.owner_at)
+        local after = same(place)
+        local count_now = bytes(place.manager + M_COUNT, 4)
+        local problem = (not after and 'the weapon changed while its copy was made')
+            or (pointer_at(place.manager + M_COPIES) ~= copies and 'the private copies moved while one was made')
+            or (after.index ~= count and 'the copy was not registered at the expected index')
+            or ((not count_now or u32(count_now, 0) ~= count + 1) and 'the private copies\' count did not grow by one')
+            or (bytes(copies + COPY_BYTES * count, COPY_BYTES) ~= baseline and 'the copy differs from its type')
+            or (bytes(original, COPY_BYTES) ~= baseline and 'the weapon type changed')
+        if problem then
+            self.broken = problem
+            return nil, problem .. ': the weapon source is off for this session'
+        end
+        self.made = self.made + 1
+        return true
+    end
+
+    -- The role id of every material of a live unit: {[material] = role}, or nil and why.
+    local function roles_of(unit)
+        if native.alive(unit) == 0 then return nil, 'the weapon unit is not alive' end
+        local out = {}
+        local meshes = math.min(native.meshes(unit), MAX_MESHES)
+        for m = 0, meshes - 1 do
+            local mesh = tonumber(native.mesh(unit, m))
+            if mesh ~= 0 then
+                local count = math.min(native.materials(mesh), MAX_MATERIALS)
+                if count > 0 then
+                    local header = bytes(mesh + MESH_COUNT, 16)
+                    if not header then return nil, 'a weapon mesh is unreadable' end
+                    local listed, roles_at = u32(header, 0), u64(header, 8)
+                    if listed ~= count or roles_at < 0x10000 or roles_at >= 0x800000000000 then
+                        return nil, 'a weapon mesh lists its materials differently'
+                    end
+                    local roles = bytes(roles_at, 4 * count)
+                    if not roles then return nil, 'a weapon mesh\'s material roles are unreadable' end
+                    for j = 0, count - 1 do
+                        local material = tonumber(native.material(mesh, j))
+                        if material ~= 0 then
+                            local role = u32(roles, 4 * j)
+                            if role == 0 then return nil, 'a weapon material has no role' end
+                            if out[material] and out[material] ~= role then
+                                return nil, 'a weapon material has two roles'
+                            end
+                            out[material] = role
+                        end
+                    end
+                end
+            end
+        end
+        return out
+    end
+
+    -- The selector of the row journaled in `record` put back, when the row is still exactly as suppressed and the copy
+    -- still that weapon's: true when the record is done with (restored, or not ours to write); false and why when the
+    -- write failed (the record stays).
+    local function release(record)
+        local place = same(record.place)
+        if not place or not place.copy then return true end -- the weapon or its copy is gone: nothing of ours is left
+        if not sole(place.manager + M_COPY_MAP, record.id, place.index) then return true end -- another's now
+        local address = place.copy + OVERRIDE + record.row * ROW_BYTES
+        local now = bytes(address, ROW_BYTES)
+        if now ~= record.masked then return true end -- the game rewrote the row (or put it back): not ours any more
+        local ok, why = write(address, ZERO4, record.bytes:sub(1, 4))
+        if not ok then return false, why end
+        self.released = self.released + 1
+        return bytes(address, ROW_BYTES) == record.bytes
+    end
+
+    -- The rows of weapon w's own table for the materials in `bound` ({[material] = {lut, pattern, other}}: the slots
+    -- the plan binds there) suppressed, the ones held already kept; the keys of the rows held go into `wanted`. True,
+    -- or nil and why (the weapon left alone); problems with single rows into `problems`.
+    local function lease(w, bound, wanted, problems)
+        local place, why = locate(w.id)
+        if not place then return nil, why end
+        if not place.copy then return nil, 'the weapon has no private copy' end
+        if not sole(place.manager + M_COPY_MAP, w.id, place.index) then
+            return nil, 'the weapon\'s private copy is shared'
+        end
+        local roles, why_roles = roles_of(w.unit)
+        if not roles then return nil, why_roles end
+        local table_at = place.copy + OVERRIDE
+        local rows = bytes(table_at, ROWS * ROW_BYTES)
+        if not rows then return nil, 'the weapon\'s table is unreadable' end
+        -- the rows held for this weapon still as suppressed (else the game rewrote them: not ours any more)
+        for r = 0, ROWS - 1 do
+            local key, now = w.id .. ':' .. r, rows:sub(r * ROW_BYTES + 1, (r + 1) * ROW_BYTES)
+            local record = records[key]
+            if record then
+                if now == record.masked then
+                    record.place = place
+                else
+                    records[key] = nil
+                end
+            end
+        end
+        -- the rows by role: a live selector, or a held row's journaled one
+        local by_role = {}
+        for r = 0, ROWS - 1 do
+            local record = records[w.id .. ':' .. r]
+            local selector = record and u32(record.bytes, 0) or u32(rows, r * ROW_BYTES)
+            if selector ~= 0 then
+                if by_role[selector] then return nil, 'two rows of the weapon\'s table select one role' end
+                by_role[selector] = r
+            end
+        end
+        for material, slots in pairs(bound) do
+            local role = roles[material]
+            if not role then return nil, 'a bound material is not the weapon unit\'s' end
+            local r = by_role[role] -- no row: the reset leaves this material alone
+            if r then
+                local key = w.id .. ':' .. r
+                if records[key] then
+                    wanted[key] = true
+                else
+                    local now = rows:sub(r * ROW_BYTES + 1, (r + 1) * ROW_BYTES)
+                    -- the payload: a LUT (+8) or pattern (+24) of the weapon's own paint only where the plan binds
+                    -- that slot (the plan's texture replaces it); the padding (+4), decal (+16) and masks (+32) must
+                    -- be zero: an override there is not this plan's to suppress
+                    if now:sub(5, 8) ~= ZERO4 or now:sub(17, 24) ~= ZERO8 or now:sub(33, 40) ~= ZERO8
+                        or (now:sub(9, 16) ~= ZERO8 and not slots.lut)
+                        or (now:sub(25, 32) ~= ZERO8 and not slots.pattern) then
+                        self.refused = self.refused + 1
+                        problems[#problems + 1] = string.format('row %08x of %s holds an override the plan does not '
+                            .. 'bind: left to the game (its reload shows that material\'s own colors)', role, w.name)
+                    else
+                        local address = table_at + r * ROW_BYTES
+                        local ok, why_write = write(address, now:sub(1, 4), ZERO4)
+                        if not ok then
+                            problems[#problems + 1] = why_write
+                        else
+                            records[key] = {id = w.id, row = r, bytes = now, masked = ZERO4 .. now:sub(5), place = place}
+                            wanted[key] = true
+                            self.leased = self.leased + 1
+                        end
+                    end
+                end
+            end
+        end
+        return true
+    end
+
+    -- Private copies made for the resolved weapons (Weapons.resolve's {list}) that have none (the game's allocator):
+    -- how many were made (the caller resolves again), and the problems met.
+    function self.prepare(resolved)
+        local made, problems = 0, {}
+        if self.broken then return 0, {} end
+        for slot = 1, 3 do
+            local w = resolved.list[slot]
+            if w and not w.copy and unit_id(w.unit) then
+                local place, why = locate(w.id)
+                if not place then
+                    problems[#problems + 1] = why
+                elseif place.copy then
+                    made = made + 1 -- the resolve missed it: resolved again
+                else
+                    local ok, why_made = ensure(place)
+                    if ok then made = made + 1 else problems[#problems + 1] = why_made end
+                    if self.broken then break end
+                end
+            end
+        end
+        return made, problems
+    end
+
+    -- The rows of the materials `bindings` (the controller's) bind on the resolved weapons' own units suppressed; every
+    -- other row held released. Returns how many rows are held, and the problems met.
+    function self.sync(bindings, resolved)
+        local wanted, problems = {}, {}
+        if not self.broken then
+            for slot = 1, 3 do
+                local w = resolved and resolved.list[slot]
+                if w and unit_id(w.unit) then
+                    local bound = nil
+                    for _, b in ipairs(bindings) do
+                        if b.unit == w.unit then
+                            bound = bound or {}
+                            local slots = bound[b.material] or {}
+                            bound[b.material] = slots
+                            if b.slot == Engine.LUT_SLOT then slots.lut = true
+                            elseif b.slot == Engine.PATTERN_SLOT then slots.pattern = true
+                            else slots.other = true end
+                        end
+                    end
+                    if bound then
+                        local ok, why = lease(w, bound, wanted, problems)
+                        if not ok then problems[#problems + 1] = why .. ' (' .. w.name .. ')' end
+                    end
+                end
+            end
+        end
+        for key, record in pairs(records) do
+            if not wanted[key] then
+                local done, why = release(record)
+                if done then records[key] = nil else problems[#problems + 1] = why end
+            end
+        end
+        return self.held(), problems
+    end
+
+    -- Every held row released (restore, pause, stop): whether none is left, and the problems met.
+    function self.release()
+        local problems = {}
+        for key, record in pairs(records) do
+            local done, why = release(record)
+            if done then records[key] = nil else problems[#problems + 1] = why end
+        end
+        return next(records) == nil, problems
+    end
+
+    function self.held()
+        local n = 0
+        for _ in pairs(records) do n = n + 1 end
+        return n
+    end
+
+    -- Runs on changes only: interpreted, sub-functions included (no traces in the code cache every mod shares).
+    if type(jit) == 'table' and type(jit.off) == 'function' then
+        for _, fn in ipairs({bytes, pointer_at, write, call, map_table, sole, locate, same, component, ensure, roles_of,
+                             release, lease, self.prepare, self.sync, self.release, self.held}) do
+            jit.off(fn, true)
+        end
+    end
+    return self
+end
+
+if type(jit) == 'table' and type(jit.off) == 'function' then
+    for _, fn in ipairs({u32, u64, from_hex, unit_id, WeaponSource.new}) do jit.off(fn, true) end
+end
+
+return WeaponSource

--- a/src/weapon_source.lua	1969-12-31 19:00:00.000000000 -0500
+++ b/src/weapon_source.lua	2026-10-25 02:03:35.082531947 -0400
@@ -0,0 +1,435 @@
+-- Match Your Colors: the weapons' appearance source (Recolor Weapons; Steam build 26088801 port). Goose's (HWG90)
+-- suggestion, CowboyBingus/MatchYourColors#2, after Epic LUT R6's weapon_private_config.lua and weapon_source_lease.lua
+-- (github.com/HWG90/Epic-LUT, branch r6/weapon-lut-editing).
+--
+-- The game binds a weapon's paint again whenever it reloads (every unit of the weapon in hand): for each row of the
+-- weapon's MaterialOverride table (src/weapons.lua: the weapon's copy of its customization, +200: 10 rows of 40 bytes
+-- {u32 material slot (the material's role id), u64 LUT, u64 decal, u64 pattern, u64 masks}) it puts the row's LUT on
+-- the material of that role, the material's own when the row's LUT is 0. That undid a recolor until the next frame:
+-- v1.5 read one binding every frame and bound again the frame after, a flash of the weapon's own colors on every
+-- reload (src/loadout.lua, the watch now commented out).
+-- Here the row of every material a plan binds is taken out of that table before the game reads it again: its role id
+-- (the selector, the row's first 4 bytes) is cleared in the weapon's PRIVATE copy of its customization, the 36 payload
+-- bytes kept. A reload then finds no row for those materials and leaves the recolor alone. No code is hooked or
+-- patched; the shared stock configuration (the weapon type's component, src/weapons.lua Weapons.compose) is never
+-- written.
+--
+-- Weapon customization manager [game + 0x2CE1BF8] (Weapons.CUSTOMIZATION; 0x3326A38 on build 25480438): +0x278 the
+-- map from a weapon's entity id to its instance; +0x290 the instances' owners (8-byte pointers to the 24-byte entity
+-- records src/weapons.lua entity_record reads: +0 the weapon's id, +8 the entity id, +12 its unit); +0x2A0 the
+-- records src/weapons.lua reads (128 bytes); +0x2B8 the map from the entity id to its private copy among [+0x2F8]
+-- (4872 bytes each, +0x2F0 how many, +0x25C how many fit). A weapon without a copy (no paint, no attachment of its own)
+-- uses the type's shared component: the game's own allocator (game.dll + 0x75CA50; 0x7512E0 on build 25480438) is
+-- asked for a copy with an empty customization descriptor (three zero words), which leaves every byte as the
+-- component's. The first 50 bytes of the allocator and of the helper it calls (0x51DCA0) are compared before the call,
+-- and after it the copy is compared with the component byte for byte, the component with itself, the count and the
+-- map with the copy's index: any difference disables the source for the session (nothing more is written).
+--
+-- Every write is one 4-byte selector in committed private read-write memory (memory.writable_data), its 40-byte row
+-- read before and after. The original row is journaled and put back on release (Recolor Weapons off, the Helldiver
+-- lost, a pause or stop, a weapon dropped or swapped, a material no longer bound) only while the row still holds
+-- exactly the suppressed bytes and the copy is still that weapon's own: a row the game rewrote (another paint, the
+-- row put back by the game) or a copy that is another weapon's now is never written. The copies can move (the storage
+-- compacts), so their addresses are resolved again from the maps on every sync and release.
+-- Everything here runs on changes only (an apply, a restore, a resolve): no read on an idle frame; the Armory's weapon
+-- preview is never leased (nothing reloads there). Another mod user's weapons (src/remote.lua) have no source.
+local ffi = require('ffi')
+
+local WeaponSource = {}
+
+WeaponSource.ALLOCATOR = 0x75CA50
+-- {game.dll offset, the first 50 bytes}: the allocator and the helper it calls, both read before any call.
+WeaponSource.SIGNATURES = {
+    {0x75CA50, '48895c240848896c2410488974241848897c242041564883ec408b4208498be83b055e266e024c8bf2488bd90f848600'},
+    {0x51DCA0, '48895c240848896c24104889742418574883ec208b5a04498bf0448b4a08488bfa4403cb488be9413bd973320f1f4000'},
+}
+local M_INSTANCES, M_OWNERS, M_COPY_MAP, M_COPIES, M_COUNT, M_CAPACITY = 0x278, 0x290, 0x2B8, 0x2F8, 0x2F0, 0x25C
+local COPY_BYTES, OVERRIDE, ROWS, ROW_BYTES = 4872, 200, 10, 40
+-- A mesh's material count (+0x58) and its materials' role ids ([+0x60]: u32 each, by material index): the ids the
+-- MaterialOverride rows select (Epic LUT R6 weapon_source_lease.lua). The count must equal Mesh.num_materials.
+local MESH_COUNT, MESH_ROLES = 0x58, 0x60
+-- The weapon types' components [entities + 0xF147B8]: 392 buckets of 16 bytes {u64 weapon id, u32 index}, each
+-- component at +0x1880 + 4872 index (src/weapons.lua Weapons.compose; build 26088801).
+local TYPES, TYPE_BUCKETS, TYPE_BASE = 0xF147B8, 392, 0x1880
+local MAX_MAP, MAX_MESHES, MAX_MATERIALS = 4096, 64, 64
+local HIGH = 4294967296
+local ZERO4 = '\0\0\0\0'
+local ZERO8 = ZERO4 .. ZERO4
+
+local function u32(s, o)
+    local a, b, c, d = s:byte(o + 1, o + 4)
+    return a + b * 256 + c * 65536 + d * 16777216
+end
+local function u64(s, o) return u32(s, o) + u32(s, o + 4) * HIGH end
+local function from_hex(hex) return (hex:gsub('..', function(pair) return string.char(tonumber(pair, 16)) end)) end
+local function unit_id(v) return v ~= 0 and v ~= 0xFFFFFFFF end

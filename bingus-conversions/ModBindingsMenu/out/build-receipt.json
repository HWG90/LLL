   "old_text": "local function check(condition, reason)\n    if not condition then error(reason, 0) end\nend\n",
   "new_text": "local function check(condition, reason)\n    if not condition then error(reason, 0) end\nend\n-- Port to Steam build 26088801: the game keeps some of its code pages no-access until it first runs them\n-- (its protection runtime decrypts them then), so a prologue read on the first frame can fail although the\n-- code is right. Each native is verified through ReadProcessMemory (read) when its page is resident, else\n-- right before its first call; it is never called unchecked, and bytes that differ refuse the build.\nlocal NATIVE_ORDER = {'build_rows', 'set_tab_labels', 'reset_list', 'consume'}\nlocal NATIVE_CODE = {\n    build_rows = {BUILD_ROWS_RVA, '\\x48\\x8b\\xc4\\x53\\x41\\x56\\x48\\x81\\xec\\xd8\\x00\\x00\\x00',\n                  'binding list builder changed', 'void (__fastcall *)(void *, const void *)'},\n    set_tab_labels = {SET_TAB_LABELS_RVA, '\\x48\\x89\\x54\\x24\\x10\\x53\\x56\\x48\\x83\\xec\\x68\\x0f\\x29\\x74\\x24\\x30',\n                      'tab bar label setter changed', 'void (__fastcall *)(void *, const void *, int)'},\n    reset_list = {LIST_RESET_RVA, '\\x40\\x53\\x48\\x83\\xec\\x20\\x48\\x8b\\xd9\\x85\\xd2\\x74\\x30\\x83\\xea\\x01',\n                  'binding list reset changed', 'void (__fastcall *)(void *, int)'},\n    consume = {INPUT_CONSUME_RVA, '\\x40\\x53\\x48\\x83\\xec\\x20\\x4c\\x8b\\xd1\\x4c\\x8b\\xca\\x48\\x8b\\xca\\xe8\\x1c\\xda\\x3f\\xff',\n               'input consume routine changed', 'MBM_consume_action'},\n}\nlocal native_fn = {}\n-- true once verified (the function is then cast), false when the bytes differ, nil while unreadable.\nlocal function native_ready(name)\n    if native_fn[name] then return true end\n    local entry = NATIVE_CODE[name]\n    local bytes = read(state.base + entry[1], #entry[2])\n    if bytes == nil then return nil end\n    if bytes ~= entry[2] then return false end\n    native_fn[name] = ffi.cast(entry[4], state.base + entry[1])\n    return true\nend\n-- A native found changed after the build check (its page was not resident then): the build check's\n-- refusal (the update stops, the borrowed slots go back, the bindings turn inert), then the error.\nlocal function refuse_native(name)\n    local reason = NATIVE_CODE[name][3]\n    guard.stop(reason)\n    state.base, state.unsupported, state.build_rows = nil, true, nil\n    note(INACTIVE_NOTE)\n    error(reason, 0)\nend\n-- The verified native, or nil while its page is not resident; refuses on changed bytes.\nlocal function native(name)\n    local fn = native_fn[name]\n    if fn then return fn end\n    local ready = native_ready(name)\n    if ready == false then refuse_native(name) end\n    return native_fn[name]\nend\n-- The page's natives as Mod Bindings Menu calls them (state.build_rows, state.set_tab_labels).\nlocal function port_build_rows(...)\n    local fn = native('build_rows')\n    check(fn, 'binding list builder not resident')\n    return fn(...)\nend\nlocal function port_set_tab_labels(...)\n    local fn = native('set_tab_labels')\n    check(fn, 'tab bar label setter not resident')\n    return fn(...)\nend\n-- The first of them not verified yet (its page not resident), or nil: page_frame waits for it.\nlocal function page_code_waiting()\n    if state.build_rows == port_build_rows and not native('build_rows') then return 'build_rows' end\n    if state.set_tab_labels == port_set_tab_labels and not native('set_tab_labels') then\n        return 'set_tab_labels'\n    end\n    return nil\nend\n"
